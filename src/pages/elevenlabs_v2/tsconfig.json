{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src*"],
      "@/app*": ["./src/app*"],
      "@/entities*": ["./src/entities*"],
      "@/features*": ["./src/features*"],
      "@/shared*": ["./src/shared*"],
      "@/widgets*": ["./src/widgets*"],
      "@prisma/*": ["./src/shared/generated/prisma/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
